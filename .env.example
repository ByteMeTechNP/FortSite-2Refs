# Browser-safe frontend configuration only.
# Vite exposes every VITE_* value to client code. Never put secrets here.
# Copy this file to .env.local and replace the placeholder key.
# Do not commit .env.local. The publishable key is public, but it still stays
# out of source so it can be rotated without a code change.

VITE_APP_NAME=FortSite
VITE_APP_ENV=development

# Non-production Supabase Cloud project FortSite - 2Merged.
# Project ref: rvfoveqprrtobmywaodf
VITE_SUPABASE_URL=https://rvfoveqprrtobmywaodf.supabase.co

# Paste the publishable key (sb_publishable_...) from the Supabase dashboard
# or the connected MCP get_publishable_keys result. Do not paste a secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
